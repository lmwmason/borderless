{
  "name": "borderless",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "npm run build:migrations && next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/test.ts",
    "verify:nvidia": "node --env-file-if-exists=.env.local --import tsx scripts/verify-nvidia.ts",
    "test:e2e": "playwright test tests/browser.spec.ts tests/pricing.spec.ts tests/marketplace.spec.ts tests/admin.spec.ts --workers=1",
    "db:local": "tsx scripts/db-local.ts",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "data:import": "node --env-file-if-exists=.env.local --import tsx scripts/import-legacy.ts",
    "build:migrations": "esbuild scripts/migrate.ts --bundle --platform=node --format=cjs --external:pg-native --outfile=.release/migrate.cjs",
    "admin:init": "node --env-file-if-exists=.env.local --import tsx scripts/admin-init.ts"
  },
  "dependencies": {
    "better-auth": "^1.7.14",
    "drizzle-orm": "^0.45.4",
    "next": "^16.0.0",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^18.6.0-beta.19",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
